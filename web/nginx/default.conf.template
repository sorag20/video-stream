server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # --- API プロキシ ---
    # Kubernetes では Gateway API (HTTPRoute) が /videos, /stream を直接各サービスへ振り分けるため、
    # ここを通るのは docker compose などで Web コンテナ単体を入口にした場合のみ

    location /videos {
        proxy_pass ${UPLOAD_SERVICE_URL};

        # 最大 2GB のアップロードをバッファリングせずにそのまま流す
        client_max_body_size 2048m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /stream/ {
        proxy_pass ${STREAMING_SERVICE_URL};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # --- 静的ファイル ---

    # Vite のビルド成果物はファイル名にハッシュを含むためイミュータブル
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
